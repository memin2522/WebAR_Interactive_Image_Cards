# Port where the app is published (http://localhost:8000).
WEB_PORT=8000

# Register API endpoint (Interaction Register API). Empty = no records are sent.
# Example with that API running locally: http://localhost:3000/api/register
REGISTER_API_URL=

# Identifier sent as "interactive" in each record.
# The original deployment used: comedor-ar
REGISTER_INTERACTIVE_ID=interactive-image-cards
